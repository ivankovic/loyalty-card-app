# Formats what is about to be committed: rustfmt on staged Rust, Biome on staged web files.
# Enabled with `make hooks`. Refuses when a file to format also has unstaged changes, because
# formatting and re-staging it would commit those too.
set -e
rust=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
web=$(git diff --cached --name-only --diff-filter=ACM -- 'web/*.ts' 'web/*.css' 'web/*.json' | sed 's#^web/##')
for file in $rust $(printf '%s\n' $web | sed 's#^#web/#'); do
    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes; stage or stash them first" >&2
        exit 1
    fi
done
if [ -n "$rust" ]; then
    rustfmt --edition 2024 $rust
    git add $rust
fi
if [ -n "$web" ]; then
    (cd web && bunx biome check --write --no-errors-on-unmatched $web)
    git add $(printf '%s\n' $web | sed 's#^#web/#')
fi
